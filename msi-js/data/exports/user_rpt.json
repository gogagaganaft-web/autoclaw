    "query": "declare @dog int      = -10;\r\ndeclare @vid int      = (SELECT ROW_ID FROM stack.[Виды параметров] WHERE Название = 'ПП_428');\r\ndeclare @now datetime = GETDATE();\r\n\r\nwith info as (\r\n    select o.ROW_ID id,\r\n\tstack.strcat(ch.ФИО,     ',' + CHAR(10)) ФИОРук,\r\n\tstack.strcat(ch.Телефон, ',' + CHAR(10)) ТелРук    \r\n\tfrom stack.Организации o\r\n    inner join stack.[Частные лица] ch\r\n        on ch.[Организация-Частные лица] = o.ROW_ID\r\n       and ch.Признаки = 1\r\n    group by o.ROW_ID\r\n),\r\npp as (\r\n    select dog.ROW_ID,\r\n           max(case when k.ДополнительныйТип = 1\r\n                    then 'Пострадавшие отрасли от COVID-19' else '' end) Тип1,\r\n           max(case s.Значение\r\n                    when 1 then 'Системообразующие организации'\r\n                    when 2 then 'Стратегические предприятия и АО'\r\n                    when 3 then 'Стратегические организации и ФОИВ'\r\n                    else '' end) Тип2\r\n    from stack.Договор dog\r\n    left join stack.Классификаторы k\r\n        on dog.[Отрасль-Договоры] = k.ROW_ID and k.ДополнительныйТип = 1\r\n    left join stack.Свойства s\r\n        on s.[Параметры-Договор] = dog.ROW_ID\r\n       and s.[Виды-Параметры] = @vid\r\n       and @now between s.ДатНач and s.ДатКнц\r\n    group by dog.ROW_ID\r\n)\r\nselect\r\n    d.номер,\r\n    c.отделение,\r\n    c.участок,\r\n    case when d.[Бюджет-Договоры] <> -1 then 'Бюджет' else '' end бюджет,\r\n    case d.[Тип договора]\r\n    when 1 then 'Договор энергоснабжения' \r\n    when 2 then 'Договор купли-продажи' \r\n    when 3 then 'Договор население (квитанции)'\r\n    when 4 then 'Договор хозяйственные нужды'\r\n    when 5 then 'Компенсация потерь сетевых компаний'\r\n    when 6 then 'Договор оказания услуг по передаче электрической энергии'\r\n    when 7 then 'Договор купли-продажи в целях компенсации фактических потерь, возникающих в электрических сетях'\r\n    when 8 then 'Договор купли-продажи электрической энергии в целях компенсации потерь электрической энергии в электрических сетях'\r\n    when 9 then 'Договор для расчетов'  \r\n    when 10 then 'Договор водоснабжения' \r\n    when 11 then 'Договор теплоснабжения' \r\n    when 12 then 'Договор СОИ' \r\n    else '' end тип,\r\n    c.КатегорияНазвание,\r\n    c.ОтрасльНазвание,\r\n    case when t.Тип1 = '' then t.Тип2 else t.Тип1 end ПП_428,\r\n    d.[Дата подписания]       дата_подписания,\r\n    d.[Дата расторжения]      дата_расторжения,\r\n    p.Наименование            Плательщик_наименование,\r\n    p.Название                Плательщик_название,\r\n    p.Адрес                   Плательщик_юрадрес,\r\n    p.ФактАдрес               Плательщик_фактадрес,\r\n    p.ИНН, p.КПП, p.ОГРН, p.email,\r\n    info_p.ФИОРук             Плательщик_ФИОрук,\r\n    info_p.ТелРук             Плательщик_телрук,\r\n    g.Наименование            Грузополучатель_наименование,\r\n    g.Название                Грузополучатель_название,\r\n    g.Адрес                   Грузополучатель_юрадрес,\r\n    g.ФактАдрес               Грузополучатель_фактадрес,\r\n    g.ИНН, g.КПП, g.ОГРН, g.email,\r\n    info_g.ФИОРук             Грузополучатель_ФИОрук,\r\n    info_g.ТелРук             Грузополучатель_телрук,\r\n    z.Наименование            Заказчик_наименование,\r\n    z.Название                Заказчик_название,\r\n    z.Адрес                   Заказчик_юрадрес,\r\n    z.ФактАдрес               Заказчик_фактадрес,\r\n    z.ИНН, z.КПП, z.ОГРН, z.email,\r\n    info_z.ФИОРук             Заказчик_ФИОрук,\r\n    info_z.ТелРук             Заказчик_телрук,\r\n    d.[Адрес доставки]        адрес_доставки,\r\n    dog.фио                   договорник,\r\n    ras.ФИО                   расчетчик,\r\n    pret.ФИО                  претензионист\r\nfrom stack.Договор d\r\ninner join stack.contracts(@dog) c on d.ROW_ID = c.Договор\r\ninner join stack.Организации p on p.ROW_ID = d.Плательщик\r\ninner join stack.Организации g on g.ROW_ID = d.Грузополучатель\r\nleft  join stack.Организации z on z.ROW_ID = d.Заказчик\r\nleft  join stack.Сотрудники dog  on d.Сотрудник2 = dog.ROW_ID\r\nleft  join stack.Сотрудники ras  on ras.ROW_ID = d.Сотрудник1\r\nleft  join stack.Сотрудники pret on pret.ROW_ID = d.Сотрудник5\r\nleft  join info info_p on info_p.id = p.ROW_ID\r\nleft  join info info_g on info_g.id = g.ROW_ID\r\nleft  join info info_z on info_z.id = z.ROW_ID\r\nleft  join pp t on t.ROW_ID = d.ROW_ID\r\norder by c.отделение, d.номер;",
    "db": "DB4FL",
    "mandatory": [
      "БД_ЮЛ"
    ]
  },
