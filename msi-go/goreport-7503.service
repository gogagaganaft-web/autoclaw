[Unit]
Description=GOREPORT Preload (port 7503)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goreport
ExecStart=/opt/goreport/server-7503
Restart=always
RestartSec=5
User=www-data
EnvironmentFile=/opt/goreport/.env
StandardOutput=append:/opt/goreport/server-7503.log
StandardError=append:/opt/goreport/server-7503.log

[Install]
WantedBy=multi-user.target
