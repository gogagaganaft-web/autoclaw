[Unit]
Description=GOREPORT Report (port 7502)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goreport
ExecStart=/opt/goreport/server-7502
Restart=always
RestartSec=5
User=www-data
EnvironmentFile=/opt/goreport/.env
StandardOutput=append:/opt/goreport/server-7502.log
StandardError=append:/opt/goreport/server-7502.log

[Install]
WantedBy=multi-user.target
