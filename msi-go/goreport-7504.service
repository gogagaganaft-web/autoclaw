[Unit]
Description=GOREPORT Multi-DB (port 7504)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goreport
ExecStart=/opt/goreport/server-7504
Restart=always
RestartSec=5
User=www-data
EnvironmentFile=/opt/goreport/.env
StandardOutput=append:/opt/goreport/server-7504.log
StandardError=append:/opt/goreport/server-7504.log

[Install]
WantedBy=multi-user.target
