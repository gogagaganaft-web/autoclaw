[Unit]
Description=GOREPORT Execute (port 7501)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goreport
ExecStart=/opt/goreport/server-7501
Restart=always
RestartSec=5
User=www-data
EnvironmentFile=/opt/goreport/.env
StandardOutput=append:/opt/goreport/server-7501.log
StandardError=append:/opt/goreport/server-7501.log

[Install]
WantedBy=multi-user.target
