<template>
  <div class="view-wrapper qq">
    <div class="qq__toolbar theme-dependent">
      <dx-button
        icon="panelleft"
        styling-mode="outlined"
        :hint="listOpen ? 'Скрыть список' : 'Показать список'"
        @click="listOpen = !listOpen"
      />
      <dx-button
        icon="panelright"
        styling-mode="outlined"
        :hint="filtersOpen ? 'Скрыть фильтры' : 'Показать фильтры'"
        @click="filtersOpen = !filtersOpen"
      />
      <dx-button
        icon="plus"
        text="Новый"
        styling-mode="outlined"
        hint="Новый запрос"
        @click="createNew()"
      />
      <dx-button
        icon="copy"
        styling-mode="outlined"
        hint="Дублировать выбранный"
        :disabled="!active.key || isNew"
        @click="duplicate()"
      />
      <dx-button
        icon="trash"
        styling-mode="outlined"
        hint="Удалить выбранный"
        :disabled="!active.key || isNew"
        @click="removeCurrent()"
      />

      <span class="qq__spacer" />

      <span
        v-if="status"
        class="qq__status"
        :class="{ 'qq__status--error': statusError }"
      >{{ status }}</span>
      <dx-button
        text="Выполнить"
        icon="run"
        type="success"
        styling-mode="contained"
        :disabled="!canRun"
        @click="run()"
      />
      <dx-button
        text="Сохранить"
        icon="save"
        type="default"
        styling-mode="contained"
        :disabled="!canSave"
        @click="save()"
      />
    </div>

    <div class="qq__body">
      <!-- ─── Слева: DataGrid запросов (Ключ скрыт, Название, Темы) ────── -->
      <aside
        v-show="listOpen"
        class="qq__list theme-dependent"
        :style="{ width: `${listWidth}px` }"
      >
        <div class="qq__grid-wrap">
          <dx-data-grid
            ref="listGridRef"
            :data-source="gridRows"
            key-expr="key"
            :columns="listColumns"
            :show-borders="false"
            :show-column-lines="false"
            :show-column-headers="true"
            :column-auto-width="true"
            :word-wrap-enabled="true"
            :hover-state-enabled="true"
            :filter-row="{ visible: true, applyFilter: 'auto' }"
            :header-filter="{ visible: true }"
            :selected-row-keys="active.key ? [active.key] : []"
            :focused-row-key="active.key"
            focused-row-enabled
            height="100%"
            @row-click="onGridRowClick"
            @row-updated="onGridRowUpdated"
          >
            <dx-column
              data-field="key"
              caption="Ключ"
              :visible="false"
            />
            <dx-column
              data-field="title"
              caption="Название"
              :editing="{ allowUpdating: true }"
            />
            <dx-column
              data-field="tagsText"
              caption="Темы"
              :editing="{ allowUpdating: true }"
              :header-filter="{ dataSource: tagsHeaderFilter }"
            />
            <dx-paging :page-size="50" />
          </dx-data-grid>
        </div>
      </aside>

      <!-- Скрытый список: сплиттер заменяет кнопку-кнопкой в тулбаре,
           здесь остаётся тонкая полоса для возврата через тулбар -->
      <div
        v-if="listOpen"
        class="qq__splitter"
        role="separator"
        aria-orientation="vertical"
        title="Потяните, чтобы изменить ширину списка"
        @mousedown="startListResize"
      />

      <!-- ─── Центр: редактор SQL + грид результата ─────────────────────── -->
      <section
        v-if="active.key || isNew"
        class="qq__panel theme-dependent"
      >
        <header class="qq__head">
          <div class="qq__head-title">
            {{ active.title || 'Новый запрос' }}
            <span class="qq__head-sub">· {{ active.key || 'без ключа' }}</span>
          </div>
          <dx-button
            icon="clock"
            styling-mode="text"
            hint="История изменений"
            :disabled="!active.key || isNew"
            @click="openHistory()"
          />
        </header>

        <div class="qq__scroll">
          <!-- Свойства: ключ (новый) и темы — база переехала в шапку -->
          <div class="qq__props-grid">
            <label
              v-if="isNew"
              class="qq__field"
            >
              <span class="qq__field-label">Ключ <b>*</b></span>
              <dx-text-box
                :value="active.key"
                placeholder="OSV_platezhi"
                @value-changed="set('key', $event.value)"
              />
            </label>
            <label
              v-if="isNew"
              class="qq__field"
            >
              <span class="qq__field-label">Название <b>*</b></span>
              <dx-text-box
                :value="active.title"
                placeholder="ОСВ: платежи"
                @value-changed="set('title', $event.value)"
              />
            </label>
            <label class="qq__field">
              <span class="qq__field-label">Темы</span>
              <dx-tag-box
                :value="active.tags"
                :items="themeOptions"
                :accept-custom-value="true"
                :show-selection-controls="true"
                placeholder="ОСВ, КТР…"
                @value-changed="set('tags', $event.value || [])"
              />
            </label>
            <label class="qq__field">
              <span class="qq__field-label">База данных</span>
              <dx-select-box
                :value="active.db_key"
                :items="dbOptions"
                value-expr="id"
                display-expr="name"
                :show-clear-button="true"
                placeholder="Не выбрана"
                @value-changed="set('db_key', $event.value)"
              />
            </label>
          </div>

          <!-- SQL -->
          <div class="qq__chips">
            <button
              v-for="token in insertTokens"
              :key="token"
              type="button"
              class="qq__chip"
              :title="'Вставить ' + token"
              @click="insert(token)"
            >{{ token }}</button>
          </div>
          <div class="qq__monaco">
            <sql-editor
              ref="editorRef"
              v-model="draft.sql"
              :height="editorHeight"
              :db-name="active.db_key"
              @update:model-value="onSqlInput($event)"
            />
          </div>

          <!-- Горизонтальный ресайз редактор ↔ грид -->
          <div
            class="qq__hresizer"
            role="separator"
            aria-orientation="horizontal"
            title="Потяните, чтобы изменить высоту редактора и таблицы"
            @mousedown="startSqlResize"
          />
          <div class="qq__result">
            <dx-data-grid
              ref="resultGridRef"
              :data-source="resultRows"
              :columns="resultColumns"
              :show-borders="true"
              :column-auto-width="true"
              :allow-column-resizing="true"
              :hover-state-enabled="true"
              height="100%"
            />
          </div>
        </div>
      </section>

      <!-- Пустое состояние -->
      <section
        v-else
        class="qq__placeholder theme-dependent"
      >
        Выберите запрос в списке слева или создайте новый.
      </section>

      <!-- ─── Справа: фильтры запроса и их значения ─────────────────────── -->
      <template v-if="active.key || isNew">
        <div
          class="qq__splitter"
          title="Потяните, чтобы изменить ширину блока фильтров"
          @mousedown="startFiltersResize"
        />
        <aside
          v-show="filtersOpen"
          class="qq__filters theme-dependent"
          :style="{ width: `${filtersWidth}px` }"
        >
          <header class="qq__filters-head">
            <span>Фильтры запроса</span>
            <dx-button
              v-if="selectedDefs.length"
              icon="refresh"
              styling-mode="text"
              hint="Подставить динамические умолчания (прошлый месяц…)"
              @click="applyDefaults()"
            />
          </header>

          <!-- Свой скролл: выбор фильтров + значения, фильтры бывают высокими -->
          <div class="qq__filters-body">
            <dx-tag-box
              class="qq__filters-tag"
              :value="active.filters"
              :items="filterOptions"
              value-expr="field"
              display-expr="caption"
              :search-enabled="true"
              :show-selection-controls="true"
              placeholder="Выберите фильтры — из них строится форма и плейсхолдеры"
              @value-changed="set('filters', $event.value || [])"
            />
            <span class="qq__hint">Чекбоксы подключают фильтр; ниже появятся его значения.</span>

            <template v-if="selectedDefs.length">
              <div class="qq__section-title">Значения фильтров</div>
              <div
                v-for="def in selectedDefs"
                :key="def.field"
                class="qq__value"
              >
                <div class="qq__value-label">
                  {{ def.label || def.field }}
                  <code class="qq__value-key">{{ def.field }}</code>
                </div>
                <filter-preview
                  :key="`qv:${active.key}:${def.field}`"
                  :def="def.config"
                  :initial-value="values[def.field]"
                  @update:value="setValue(def.field, $event)"
                />
              </div>
            </template>
            <div
              v-else
              class="qq__hint"
            >
              Фильтры не подключены — выберите хотя бы один.
            </div>
          </div>
        </aside>
      </template>

    </div>

    <history-drawer
      :visible="historyOpen"
      :title="historyTitle"
      :items="historyItems"
      @close="historyOpen = false"
    />
  </div>
</template>

<script setup lang="ts">
import { computed, nextTick, onBeforeUnmount, onMounted, reactive, ref, watch } from 'vue';
import { DxButton } from 'devextreme-vue/button';
import { DxColumn, DxDataGrid, DxPaging } from 'devextreme-vue/data-grid';
import { DxSelectBox } from 'devextreme-vue/select-box';
import { DxTagBox } from 'devextreme-vue/tag-box';
import { DxTextBox } from 'devextreme-vue/text-box';
import { DxTreeView } from 'devextreme-vue/tree-view';
import FilterPreview from '@/components/library/filter-preview.vue';
import HistoryDrawer, { type HistoryItem } from '@/components/common/history-drawer.vue';
import SqlEditor from '@/components/report-editor/sql-editor.vue';
import { filtersApi, type FilterDef } from '@/services/filters-api';
import {
  queriesApi,
  type QueryColumn,
  type QueryDef,
  type QueryPayload,
} from '@/services/queries-api';
import { reportsApi } from '@/services/reports-api';
import { filterPrototype } from '@/utils/filter-prototypes';
import { dynamicFilterValue, placeholderTokens } from '@/utils/filter-values';
import { interpolateQuery } from '@/utils/query-interpolate';

// Запросы, три колонки: DataGrid запросов (edit-in-row) | SQL + результат |
// фильтры запроса и их значения. Список и фильтры скрываются кнопками,
// ширины тянутся сплиттерами. Всё — виджеты MSI.

interface DatabaseOption { id: string; name: string }

const items = ref<QueryDef[]>([]);
const allItems = ref<QueryDef[]>([]);
const filterDefs = ref<FilterDef[]>([]);
const dbOptions = ref<DatabaseOption[]>([]);

const status = ref('');
const statusError = ref(false);

/** Уникальные темы для header-фильтра колонки «Темы». */
const tagsHeaderFilter = computed(() => {
  const set = new Set<string>();
  for (const item of allItems.value) {
    for (const tag of item.tags || []) set.add(tag);
  }
  return [...set].sort().map((tag) => ({ value: tag, text: tag }));
});
const running = ref(false);
const isNew = ref(false);

const listOpen = ref(true);
const filtersOpen = ref(true);
// Стартовые пропорции: 20% / 40% / 40% ширины окна.
const listWidth = ref(Math.round(window.innerWidth * 0.2));
const filtersWidth = ref(Math.round(window.innerWidth * 0.4));

const editorHeight = ref(340);
const resultHeight = ref(320);

const active = reactive({
  key: '',
  title: '',
  tags: [] as string[],
  db_key: '',
  filters: [] as string[],
});
const draft = reactive<{ sql: string; dirty: boolean }>({ sql: '', dirty: false });
const values = reactive<Record<string, unknown>>({});

const historyOpen = ref(false);
const historyTitle = ref('');
const historyItems = ref<HistoryItem[]>([]);

const resultRows = ref<Record<string, unknown>[]>([]);
const resultColumns = ref<Array<{ dataField: string; caption: string }>>([]);

const editorRef = ref<{ insertPlaceholder: (text: string) => void } | null>(null);
const resultGridRef = ref<any>(null);
const listGridRef = ref<any>(null);

/** Сборка MSI игнорирует searchPanel/filterRow в конструкторе DataGrid —
 *  включаем пост-созданием после первого запуска. */
function enableResultGridSearch(): void {
  const inst = resultGridRef.value?.instance;
  if (!inst) return;
  try {
    inst.option('filterRow', {
      visible: true,
      applyFilter: 'auto',
    });
    inst.option('searchPanel', { visible: false });
    inst.option('headerFilter', { visible: true });
  } catch { /* не критично */ }
}

watch([resultRows, resultColumns], () => {
  void nextTick(() => enableResultGridSearch());
});

// ─── СПИСОК ЗАПРОСОВ: DataGrid с правкой в строке ───────────────────────────

const gridRows = computed(() => items.value.map((item) => ({
  key: item.key,
  title: item.title || item.key,
  tagsText: (item.tags || []).join(', '),
})));

const listColumns = [
  { dataField: 'title', caption: 'Название', editing: { allowUpdating: true } },
  { dataField: 'tagsText', caption: 'Темы', editing: { allowUpdating: true } },
];

function onGridRowClick(e: {
  rowType?: string;
  data?: { key?: string };
  component?: { getVisibleRows?: () => Array<{ data?: { key?: string } }> };
  rowIndex?: number;
}): void {
  if (e.rowType !== 'data') return;
  // Ключ скрыт колонкой visible:false — в data его может не быть.
  // Берём строку по индексу и читаем ключ из неё.
  let key = e.data?.key;
  if (!key && typeof e.component?.getVisibleRows === 'function') {
    const rows = e.component.getVisibleRows();
    key = String(rows[e.rowIndex ?? -1]?.data?.key ?? '');
  }
  if (!key) return;
  if (key !== active.key) open(key);
}

/** Поиск в левом гриде: searchPanel и filterRow сборки MSI применяем
 *  пост-созданием (в конструкторе игнорируются). */
function applyListSearch(): void {
  const inst = listGridRef.value?.instance;
  if (!inst) return;
  try {
    inst.option('searchPanel', { visible: true, width: 200, placeholder: 'Поиск…' });
    inst.option('filterRow', { visible: true, applyFilter: 'auto' });
    inst.option('headerFilter', { visible: true });
  } catch { /* не критично */ }
}

/** Правка названия/тем в строке: читаем отчёт, меняем только эти поля. */
async function onGridRowUpdated(e: { data?: Record<string, unknown>; key?: string }): Promise<void> {
  const key = String(e?.key ?? e?.data?.key ?? '');
  if (!key) return;
  try {
    const report = await queriesApi.get(key);
    const title = String(e?.data?.title ?? report.title ?? '');
    const tags = String(e?.data?.tagsText ?? (report.tags || []).join(', '))
      .split(',').map((t) => t.trim()).filter(Boolean);
    await queriesApi.update(key, {
      key,
      title,
      tags,
      db_key: report.db_key || '',
      filters: report.filters || [],
      sql: report.sql || '',
      columns: report.columns || [],
    });
    items.value = items.value.map((item) => (item.key === key
      ? { ...item, title, tags }
      : item));
    if (active.key === key) {
      active.title = title;
      active.tags = tags;
    }
    status.value = 'Строка сохранена';
    statusError.value = false;
  } catch (err) {
    status.value = `Не удалось сохранить строку: ${(err as Error).message}`;
    statusError.value = true;
  }
}

// ─── ВЫЧИСЛЯЕМЫЕ ────────────────────────────────────────────────────────────

const canRun = computed(() => Boolean(draft.sql.trim()) && !running.value && !isNew.value);
const canSave = computed(() =>
  Boolean(active.key.trim() && active.title.trim() && draft.sql.trim()) && draft.dirty);

const dbLabel = computed(() => {
  const found = dbOptions.value.find((item) => item.id === active.db_key);
  return found ? found.name : active.db_key;
});

const filterOptions = computed(() => filterDefs.value.map((def) => ({
  field: def.field,
  caption: `${def.field} — ${def.label || def.type}`,
})));

const themeOptions = computed(() => {
  const all = new Set<string>();
  for (const item of allItems.value) {
    for (const tag of item.tags || []) all.add(tag);
  }
  return [...all].sort();
});

const selectedDefs = computed(() => filterDefs.value.filter((def) => active.filters.includes(def.field)));

// Подключение фильтра — сразу стартовое значение в placeholder var:
// диапазоны получают d/m/n_start+end, чтобы чип в SQL сразу был «заполнен».
watch(selectedDefs, (defs) => {
  for (const def of defs) {
    if (values[def.field] !== undefined) continue;
    const proto = filterPrototype(def.type);
    if (!proto) continue;
    const value = dynamicFilterValue(proto);
    if (value === undefined) continue;
    values[def.field] = value;
  }
});

const insertTokens = computed(() => {
  const tokens: string[] = [];
  for (const def of selectedDefs.value) {
    const proto = filterPrototype(def.type);
    if (!proto) continue;
    tokens.push(...placeholderTokens(proto, def.field, def.config.var as string[] | undefined));
  }
  return [...new Set(tokens)];
});

// ─── ЗАГРУЗКА ───────────────────────────────────────────────────────────────

async function load() {
  try {
    const [list, filters, databases] = await Promise.all([
      queriesApi.list(),
      filtersApi.list().catch(() => ({ filters: [] as FilterDef[], total: 0 })),
      reportsApi.getDatabases().catch(() => ({ databases: [] })),
    ]);
    allItems.value = list.queries || [];
    items.value = allItems.value;
    filterDefs.value = filters.filters || [];
    dbOptions.value = (databases.databases || []).map((db) => ({ id: db.id, name: db.name }));
    if (allItems.value.length && !allItems.value.some((i) => i.key === active.key)) {
      open(allItems.value[0].key);
    }
  } catch (e) {
    status.value = `Не удалось прочитать запросы: ${(e as Error).message}`;
    statusError.value = true;
  } finally {
    void nextTick(() => applyListSearch());
  }
}

function applyQuery(item: QueryDef) {
  active.key = item.key;
  active.title = item.title || '';
  active.tags = [...(item.tags || [])];
  active.db_key = item.db_key || '';
  active.filters = [...(item.filters || [])];
  draft.sql = item.sql || '';
  draft.dirty = false;
  isNew.value = false;
  for (const key of Object.keys(values)) delete values[key];
  resultRows.value = [];
  resultColumns.value = [];
}

function open(key: string) {
  const item = items.value.find((row) => row.key === key) ?? allItems.value.find((row) => row.key === key);
  if (!item) return;
  applyQuery(item);
  status.value = '';
  statusError.value = false;
}

function set<K extends 'key' | 'title' | 'tags' | 'db_key' | 'filters'>(
  field: K,
  value: (typeof active)[K],
): void {
  active[field] = value;
  draft.dirty = true;
}

function onSqlInput(): void {
  draft.dirty = true;
}

function createNew() {
  active.key = '';
  active.title = '';
  active.tags = [];
  active.db_key = '';
  active.filters = [];
  draft.sql = '';
  draft.dirty = true;
  isNew.value = true;
  for (const key of Object.keys(values)) delete values[key];
  resultRows.value = [];
  resultColumns.value = [];
  status.value = 'Новый запрос: заполните свойства и SQL';
  statusError.value = false;
  void nextTick(() => {
    document.querySelector('.qq__scroll')?.scrollTo({ top: 0 });
  });
}

function duplicate() {
  if (!active.key) return;
  active.key = '';
  active.title = `${active.title} (копия)`;
  isNew.value = true;
  draft.dirty = true;
  status.value = 'Копия создана — задайте ключ';
  statusError.value = false;
}

// ─── СОХРАНЕНИЕ ─────────────────────────────────────────────────────────────

function validate(): string[] {
  const errors: string[] = [];
  const key = active.key.trim();
  if (!key) errors.push('Укажите ключ запроса');
  else if (!/^[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*$/.test(key)) {
    errors.push('Ключ: буквы, цифры и подчёркивание, без пробелов');
  } else if (isNew.value && allItems.value.some((item) => item.key === key)) {
    errors.push(`Ключ «${key}» уже занят`);
  }
  if (!active.title.trim()) errors.push('Укажите название');
  if (!draft.sql.trim()) errors.push('SQL не заполнен');
  return errors;
}

async function save() {
  const errors = validate();
  if (errors.length) {
    status.value = errors[0];
    statusError.value = true;
    return;
  }

  const payload: QueryPayload = {
    key: active.key.trim(),
    title: active.title.trim(),
    tags: active.tags,
    db_key: active.db_key,
    filters: active.filters,
    sql: draft.sql,
    columns: resultColumns.value.map((c) => ({ dataField: c.dataField, caption: c.caption })),
  };

  try {
    if (isNew.value) {
      await queriesApi.create(payload);
      isNew.value = false;
      active.key = payload.key;
    } else {
      await queriesApi.update(active.key, payload);
    }
    draft.dirty = false;
    await load();
    status.value = `Сохранено: ${payload.key}`;
    statusError.value = false;
  } catch (e) {
    status.value = `Не удалось сохранить: ${(e as Error).message}`;
    statusError.value = true;
  }
}

async function removeCurrent() {
  if (!active.key || isNew.value) return;
  if (!window.confirm(`Удалить запрос «${active.key}»?`)) return;
  try {
    await queriesApi.remove(active.key);
    active.key = '';
    await load();
    status.value = 'Запрос удалён';
    statusError.value = false;
  } catch (e) {
    status.value = `Не удалось удалить: ${(e as Error).message}`;
    statusError.value = true;
  }
}

// ─── ВЫПОЛНЕНИЕ И ФИЛЬТРЫ ──────────────────────────────────────────────────

async function openHistory() {
  if (!active.key) return;
  try {
    const data = await queriesApi.history(active.key);
    historyTitle.value = active.key;
    historyItems.value = (data.revisions || []).map((revision) => ({
      id: revision.id,
      action: revision.action,
      at: revision.changed_at,
      by: revision.changed_by,
      detail: revision.sql ? revision.sql.slice(0, 400) : undefined,
    }));
    historyOpen.value = true;
  } catch (e) {
    status.value = `История недоступна: ${(e as Error).message}`;
    statusError.value = true;
  }
}

function applyDefaults() {
  let filled = 0;
  for (const def of selectedDefs.value) {
    const proto = filterPrototype(def.type);
    if (!proto) continue;
    const value = dynamicFilterValue(proto);
    if (value === undefined) continue;
    values[def.field] = value;
    filled += 1;
  }
  status.value = filled
    ? `Подставлены значения по умолчанию: ${filled}`
    : 'У выбранных фильтров нет динамических значений';
  statusError.value = filled === 0;
}

function setValue(field: string, value: unknown) {
  values[field] = value;
}

function insert(token: string) {
  editorRef.value?.insertPlaceholder(token);
}

function columnsFromResult(raw: unknown[]): QueryColumn[] {
  return raw.map((column, index) => {
    if (typeof column === 'string') return { dataField: column, caption: column };
    const rec = column as Record<string, unknown>;
    return {
      dataField: String(rec.dataField ?? rec.name ?? `col${index + 1}`),
      caption: String(rec.caption ?? rec.dataField ?? rec.name ?? `col${index + 1}`),
    };
  });
}

async function run() {
  if (isNew.value) {
    status.value = 'Сначала сохраните запрос';
    statusError.value = true;
    return;
  }

  const result = interpolateQuery(draft.sql, varValues());
  if (result.unresolved.length) {
    status.value = `Не заполнены значения: ${result.unresolved.join(', ')}`;
    statusError.value = true;
    return;
  }

  running.value = true;
  status.value = 'Выполняется…';
  statusError.value = false;
  try {
    const response = await queriesApi.execute(active.db_key || '', result.sql);
    if (response.error) throw new Error(response.error);

    const columns = columnsFromResult(response.columns || []);
    const rows = (response.rows || []).map((row) => {
      const record: Record<string, unknown> = {};
      columns.forEach((column, index) => {
        record[column.dataField] = Array.isArray(row) ? row[index] : null;
      });
      return record;
    });

    resultColumns.value = columns.map((c) => ({ dataField: c.dataField, caption: c.caption || c.dataField }));
    resultRows.value = rows;
    await queriesApi.saveColumns(active.key, columns).catch(() => undefined);
    status.value = `Выполнено: ${rows.length} строк`;
    statusError.value = false;
  } catch (e) {
    resultRows.value = [];
    status.value = `Ошибка выполнения: ${(e as Error).message}`;
    statusError.value = true;
  } finally {
    running.value = false;
  }
}

/**
 * Карта значений по var-контракту SQL: {fond} ← values['ФОНД'],
 * {m_start}/{m_end} ← диапазон. Диапазон с двумя var разворачивается
 * в два скаляра — как buildPayload отчёта.
 */
function varValues(): Record<string, unknown> {
  const out: Record<string, unknown> = {};
  for (const def of selectedDefs.value) {
    const proto = filterPrototype(def.type);
    if (!proto) continue;
    const names = placeholderTokens(
      proto,
      def.field,
      (def.config as Record<string, unknown>).var as string[] | undefined,
    ).map((token) => token.replace(/^\{|\}$/g, ''));
    const raw = values[def.field];
    if (names.length >= 2 && raw && typeof raw === 'object' && !Array.isArray(raw)) {
      const rec = raw as Record<string, unknown>;
      out[names[0]] = rec.start ?? '';
      out[names[1]] = rec.end ?? '';
    } else if (names.length >= 1) {
      out[names[0]] = raw;
    } else {
      out[def.field] = raw;
    }
  }
  return out;
}

// ─── РЕСАЙЗЫ ────────────────────────────────────────────────────────────────

let resizingList = false;
let listStartX = 0;
let listStartW = 0;

function onListMove(event: MouseEvent) {
  if (!resizingList) return;
  const delta = event.clientX - listStartX;
  listWidth.value = Math.min(560, Math.max(220, listStartW + delta));
}

function onListUp() {
  resizingList = false;
  document.removeEventListener('mousemove', onListMove);
  document.removeEventListener('mouseup', onListUp);
}

function startListResize(event: MouseEvent) {
  resizingList = true;
  listStartX = event.clientX;
  listStartW = listWidth.value;
  document.addEventListener('mousemove', onListMove);
  document.addEventListener('mouseup', onListUp);
}

let resizingFilters = false;
let filtersStartX = 0;
let filtersStartW = 0;

function onFiltersMove(event: MouseEvent) {
  if (!resizingFilters) return;
  const delta = filtersStartX - event.clientX;
  filtersWidth.value = Math.min(700, Math.max(280, filtersStartW + delta));
}

function onFiltersUp() {
  resizingFilters = false;
  document.removeEventListener('mousemove', onFiltersMove);
  document.removeEventListener('mouseup', onFiltersUp);
}

function startFiltersResize(event: MouseEvent) {
  resizingFilters = true;
  filtersStartX = event.clientX;
  filtersStartW = filtersWidth.value;
  document.addEventListener('mousemove', onFiltersMove);
  document.addEventListener('mouseup', onFiltersUp);
}

let resizingSql = false;
let sqlStartY = 0;
let sqlStartEditor = 0;
let sqlStartResult = 0;

function onSqlMove(event: MouseEvent) {
  if (!resizingSql) return;
  const delta = event.clientY - sqlStartY;
  const total = sqlStartEditor + sqlStartResult;
  editorHeight.value = Math.min(total - 160, Math.max(140, sqlStartEditor + delta));
  resultHeight.value = Math.max(120, total - editorHeight.value);
}

function onSqlUp() {
  resizingSql = false;
  document.removeEventListener('mousemove', onSqlMove);
  document.removeEventListener('mouseup', onSqlUp);
}

function startSqlResize(event: MouseEvent) {
  resizingSql = true;
  sqlStartY = event.clientY;
  sqlStartEditor = editorHeight.value;
  sqlStartResult = resultHeight.value;
  document.addEventListener('mousemove', onSqlMove);
  document.addEventListener('mouseup', onSqlUp);
}

// Свободное место для редактора между списком и фильтрами.
function relayout(): void {
  void nextTick(() => {
    try { editorRef.value?.['relayoutEditor']?.(); } catch { /* нет метода */ }
  });
}

watch([listWidth, filtersWidth, listOpen, filtersOpen], relayout);

onMounted(() => {
  void nextTick(() => applyListSearch());
  void load();
});

onBeforeUnmount(() => {
  document.removeEventListener('mousemove', onListMove);
  document.removeEventListener('mouseup', onListUp);
  document.removeEventListener('mousemove', onFiltersMove);
  document.removeEventListener('mouseup', onFiltersUp);
  document.removeEventListener('mousemove', onSqlMove);
  document.removeEventListener('mouseup', onSqlUp);
});
</script>

<style scoped>
.qq {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 120px);
  min-height: 480px;
}

.qq__toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 0 8px;
  margin-bottom: 8px;
  flex: 0 0 auto;
  flex-wrap: wrap;
}

.qq__spacer { flex: 1 1 auto; }

.qq__status { font-size: 12px; color: var(--dx-color-text, #374151); }
.qq__status--error { color: var(--dx-color-danger, #b91c1c); }

.qq__body {
  display: flex;
  flex: 1 1 auto;
  min-height: 0;
  gap: 0;
}

/* ─── Список: DataGrid ───────────────────────────────────────────────────── */

.qq__list {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  height: 100%;
  min-height: 0;
  border: 1px solid var(--dx-color-border, #e5e7eb);
  border-radius: 8px;
  overflow: hidden;
  color: var(--dx-color-text, #1f2937);
  background: var(--dx-component-color-bg, #fff);
}

.qq__grid-wrap {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}

.qq__splitter {
  position: relative;
  width: 6px;
  flex: 0 0 auto;
  cursor: col-resize;
  transition: background-color 0.15s ease;
}

.qq__splitter::after {
  position: absolute;
  top: 50%;
  left: 1px;
  width: 4px;
  height: 40px;
  border-radius: 2px;
  content: "";
  background-color: var(--border-color, rgba(128, 128, 128, 0.35));
  transform: translateY(-50%);
}

.qq__splitter:hover,
.qq__splitter:active {
  background-color: color-mix(in srgb, var(--border-color), var(--base-text-color) 25%);
}

/* ─── Центр: SQL + результат ─────────────────────────────────────────────── */

.qq__panel {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-width: 0;
  height: 100%;
  min-height: 0;
  color: var(--dx-color-text, #1f2937);
  background: var(--dx-component-color-bg, #fff);
  border: 1px solid var(--dx-color-border, #e5e7eb);
  border-radius: 8px;
  overflow: hidden;
}

.qq__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--dx-color-border, #e5e7eb);
  flex: 0 0 auto;
}

.qq__head-title {
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qq__head-sub {
  font-weight: 400;
  opacity: 0.65;
}

.qq__scroll {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  overflow-y: auto;
  flex: 1 1 auto;
  min-height: 0;
}

.qq__scroll::-webkit-scrollbar { width: 8px; }
.qq__scroll::-webkit-scrollbar-track { background: transparent; }
.qq__scroll::-webkit-scrollbar-thumb {
  background-color: rgba(128, 128, 128, 0.45);
  border-radius: 4px;
  background-clip: padding-box;
}
.qq__scroll::-webkit-scrollbar-thumb:hover { background-color: rgba(128, 128, 128, 0.75); }

.qq__props-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 12px;
}

.qq__field {
  display: flex;
