{
  "name": "msi-builder",
  "version": "1.0.0",
  "description": "Сборка единого бандла msi.js (MSI Library) из модулей src/",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "build:min": "node build.js --minify",
    "gen:classes": "node gen-classes.js",
    "smoke": "node smoke_test.js",
    "verify": "node build.js --minify && node gen-classes.js && node smoke_test.js",
    "release": "node build.js --minify && node gen-classes.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
